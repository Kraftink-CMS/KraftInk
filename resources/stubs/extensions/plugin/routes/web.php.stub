use %NAMESPACE%\Http\Controllers\PublicController;
use Illuminate\Support\Facades\Route;

Route::prefix('plugins/%ID%')
    ->name('plugins.%ID%.public.')
    ->middleware(['web', 'permission:plugins.%ID%.view'])
