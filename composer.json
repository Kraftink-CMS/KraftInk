{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kraftink/cms",
    "type": "project",
    "description": "KraftInk modular community CMS",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "authors": [
        { "name": "nivcoo" },
        { "name": "KraftInk" }
    ],
    "require": {
        "php": "^8.4.1",
        "php-64bit": "^8.4.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.1",
        "composer/semver": "^3.5",
        "ezyang/htmlpurifier": "^4.19",
        "laravel/framework": "^13.17",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "phpseclib/phpseclib": "^4.0",
        "pragmarx/google2fa": "^9.1",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/microsoft": "^4.10",
        "socialiteproviders/minecraft": "^5.0",
        "web-auth/webauthn-lib": "^5.2",
        "xpaw/php-source-query-class": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "npm run build:bundled",
            "composer install",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
